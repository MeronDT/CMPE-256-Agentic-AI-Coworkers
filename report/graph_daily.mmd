---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_context(load_context)
	discover(discover)
	shortlist(shortlist)
	rank(rank)
	select(select)
	summarize(summarize)
	verify(verify)
	write(write)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_context;
	discover --> shortlist;
	load_context --> discover;
	rank --> select;
	select --> summarize;
	shortlist --> rank;
	summarize --> verify;
	verify -.-> select;
	verify -.-> write;
	write --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
